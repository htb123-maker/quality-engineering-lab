# Local, non-secret defaults. Copy to .env and override locally.
QA_ENVIRONMENT=local
QA_API_BASE_URL=http://127.0.0.1:18000
QA_API_CONNECT_TIMEOUT_SECONDS=2
QA_API_READ_TIMEOUT_SECONDS=5
QA_API_WRITE_TIMEOUT_SECONDS=5
QA_API_POOL_TIMEOUT_SECONDS=2
QA_API_RETRY_MAX_ATTEMPTS=3
QA_API_RETRY_BACKOFF_SECONDS=0.25
QA_API_RETRY_MAX_BACKOFF_SECONDS=2
QA_API_RETRY_JITTER_RATIO=0.2
QA_AUTH_MODE=bearer
QA_AUTH_TOKEN_PATH=/oauth/token
QA_AUTH_REVOKE_PATH=/oauth/revoke
QA_AUTH_DISCOVERY_PATH=/.well-known/openid-configuration
QA_AUTH_REFRESH_SKEW_SECONDS=30
QA_AUTH_TEST_USERNAME=owner@atlas.example
QA_AUTH_TEST_PASSWORD=local-test-password
QA_APPIUM_SERVER_URL=http://127.0.0.1:4723
QA_ANDROID_DEVICE_NAME=Pixel_API_35_AOSP_ATD
QA_ANDROID_UDID=emulator-5554
QA_ANDROID_PLATFORM_VERSION=15
QA_ANDROID_APP_PACKAGE=com.android.fakesystemapp
QA_ANDROID_APP_ACTIVITY=.launcher.EmptyHomeActivity
QA_IOS_DEVICE_NAME=iPhone 16
# Set this to an installed iOS runtime on the macOS host, for example 18.5.
QA_IOS_PLATFORM_VERSION=
QA_IOS_UDID=
QA_IOS_BUNDLE_ID=com.apple.Preferences
QA_IOS_WDA_LOCAL_PORT=8100
QA_IOS_USE_NEW_WDA=true
QA_IOS_WDA_LAUNCH_TIMEOUT_MS=240000
QA_IOS_WDA_STARTUP_RETRIES=2
QA_IOS_WDA_STARTUP_RETRY_INTERVAL_MS=10000
QA_API_PORT=18000
QA_POSTGRES_PORT=15432
QA_REDIS_PORT=16379
QA_POSTGRES_USER=qa
QA_POSTGRES_PASSWORD=qa
QA_POSTGRES_DB=qa
QA_POSTGRES_DSN=postgresql://qa:qa@127.0.0.1:15432/qa
QA_REDIS_URL=redis://127.0.0.1:16379/0
QA_AUTH_ACCESS_TOKEN_TTL_SECONDS=300
QA_AUTH_REFRESH_TOKEN_TTL_SECONDS=3600
QA_AUTH_JWT_SECRET=local-sut-jwt-secret-not-for-production
QA_ARTIFACTS_DIR=artifacts
QA_LOG_LEVEL=INFO
