# Local, non-secret defaults. Copy to .env and override locally.
QA_ENVIRONMENT=local
QA_API_BASE_URL=http://127.0.0.1:18000
QA_API_CONNECT_TIMEOUT_SECONDS=2
QA_API_READ_TIMEOUT_SECONDS=5
QA_API_WRITE_TIMEOUT_SECONDS=5
QA_API_POOL_TIMEOUT_SECONDS=2
QA_API_RETRY_MAX_ATTEMPTS=3
QA_API_RETRY_BACKOFF_SECONDS=0.25
QA_API_RETRY_MAX_BACKOFF_SECONDS=2
QA_API_RETRY_JITTER_RATIO=0.2
# Optional Toxiproxy control port and one proxy port per pytest-xdist worker.
QA_TOXIPROXY_URL=http://127.0.0.1:18474
QA_TOXIPROXY_CONTROL_PORT=18474
QA_TOXIPROXY_PROXY_PORT_BASE=18100
QA_AUTH_MODE=bearer
QA_AUTH_TOKEN_PATH=/oauth/token
QA_AUTH_REVOKE_PATH=/oauth/revoke
QA_AUTH_DISCOVERY_PATH=/.well-known/openid-configuration
QA_AUTH_REFRESH_SKEW_SECONDS=30
QA_AUTH_TEST_USERNAME=owner@atlas.example
QA_AUTH_TEST_PASSWORD=local-test-password
QA_APPIUM_SERVER_URL=http://127.0.0.1:4723
QA_ANDROID_DEVICE_NAME=Pixel_API_35_AOSP_ATD
QA_ANDROID_UDID=emulator-5554
QA_ANDROID_PLATFORM_VERSION=15
QA_ANDROID_APP_PACKAGE=com.android.fakesystemapp
QA_ANDROID_APP_ACTIVITY=.launcher.EmptyHomeActivity
# Appium ends an idle Android session when no command arrives within this
# window. Keep enough room for a PyCharm breakpoint inspection.
QA_ANDROID_NEW_COMMAND_TIMEOUT_SECONDS=300
# UI operations use explicit polling with a bounded deadline.
QA_ANDROID_UI_WAIT_TIMEOUT_SECONDS=10
QA_ANDROID_UI_WAIT_POLL_SECONDS=0.25
QA_IOS_DEVICE_NAME=iPhone 16
# Set this to an installed iOS runtime on the macOS host, for example 18.5.
QA_IOS_PLATFORM_VERSION=
QA_IOS_UDID=
QA_IOS_BUNDLE_ID=com.apple.Preferences
QA_IOS_WDA_LOCAL_PORT=8100
QA_IOS_USE_NEW_WDA=true
QA_IOS_WDA_LAUNCH_TIMEOUT_MS=240000
QA_IOS_WDA_STARTUP_RETRIES=2
QA_IOS_WDA_STARTUP_RETRY_INTERVAL_MS=10000
QA_API_PORT=18000
QA_POSTGRES_PORT=15432
QA_REDIS_PORT=26379
QA_POSTGRES_USER=qa
QA_POSTGRES_PASSWORD=qa
QA_POSTGRES_DB=qa
QA_POSTGRES_DSN=postgresql://qa:qa@127.0.0.1:15432/qa
QA_POSTGRES_MAX_CONNECTIONS=16
QA_POSTGRES_CONNECTION_TIMEOUT_SECONDS=2
QA_REDIS_URL=redis://127.0.0.1:26379/0
QA_AUTH_ACCESS_TOKEN_TTL_SECONDS=300
QA_AUTH_REFRESH_TOKEN_TTL_SECONDS=3600
QA_AUTH_JWT_SECRET=local-sut-jwt-secret-not-for-production
QA_AUTH_ISSUER=quality-engineering-lab-local
QA_IDEMPOTENCY_TTL_SECONDS=3600
QA_RATE_LIMIT_WRITE_MAX=20
QA_RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# Second bucket keyed on the authenticated principal, so rotating the
# client-supplied X-QA-Client-Id cannot buy unlimited write budget.
QA_RATE_LIMIT_PRINCIPAL_MAX=40
# Failed password grants per (client, account) before the token endpoint answers
# 429. The counter lives in Redis and expires with the window.
QA_AUTH_SIGNIN_FAILURE_MAX=10
QA_AUTH_SIGNIN_FAILURE_WINDOW_SECONDS=60
# Largest JSON request body the SUT will read; anything bigger is 413.
QA_MAX_REQUEST_BYTES=65536
QA_CATALOG_CACHE_TTL_SECONDS=60
QA_CATALOG_CACHE_NEGATIVE_TTL_SECONDS=10
QA_CACHE_STATS_TTL_SECONDS=3600
QA_JOB_TTL_SECONDS=900
QA_JOB_WORKER_ENABLED=1
QA_JOB_WORKER_POLL_SECONDS=0.25
QA_WS_SUBSCRIBER_QUEUE_SIZE=64
QA_WS_POLL_SECONDS=0.2
QA_ARTIFACTS_DIR=artifacts
QA_LOG_LEVEL=INFO

# Yuque publishing used by scripts/sync_yuque.py.
# Create a personal token in Yuque (Settings -> token management) and keep it
# only in the git-ignored .env file.
YUQUE_API_BASE=https://www.yuque.com/api/v2
YUQUE_NAMESPACE=
YUQUE_BOOK=
YUQUE_TOKEN=
