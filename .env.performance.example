# Isolated local performance environment. All values are non-secret defaults.
QA_ENVIRONMENT=performance
QA_API_PORT=28000
QA_POSTGRES_PORT=25432
QA_REDIS_PORT=36379
QA_POSTGRES_USER=qa
QA_POSTGRES_PASSWORD=qa
QA_POSTGRES_DB=qa
QA_POSTGRES_DSN=postgresql://qa:qa@127.0.0.1:25432/qa
QA_REDIS_URL=redis://127.0.0.1:36379/0
QA_API_BASE_URL=http://127.0.0.1:28000
QA_POSTGRES_MAX_CONNECTIONS=32
QA_JOB_WORKER_ENABLED=1
